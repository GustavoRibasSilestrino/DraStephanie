# ───────────── Painel da Dra. ─────────────
# Senha de acesso ao /admin (obrigatória). Use algo longo e único.
ADMIN_PASSWORD=
# (opcional) segredo para assinar a sessão. Se vazio, deriva da senha.
AUTH_SECRET=

# ───────────── Banco de dados ─────────────
# Produção (Vercel): Postgres — Neon, Supabase, Vercel Postgres, etc.
DATABASE_URL=
# Alternativa: Turso (SQLite na nuvem)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Em desenvolvimento, se nada acima estiver definido, usa o arquivo ./data/clinic.db

# ───────────── Site ─────────────
# true = faixa "demonstração", noindex e e-mails desligados (proposta).
# false = site oficial (entregue à Dra.).
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# ───────────── E-mails (opcional) ─────────────
# Sem RESEND_API_KEY nenhum e-mail é enviado. Nunca enviam em modo demo.
RESEND_API_KEY=
MAIL_FROM="Dra. Stephanie de Oliveira <agendamento@seu-dominio.com.br>"
NOTIFY_EMAIL=
